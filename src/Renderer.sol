pragma solidity 0.8.24;

import {Base64} from "@openzeppelin/contracts/utils/Base64.sol";
import {Strings} from "@openzeppelin/contracts/utils/Strings.sol";
import {Card, OracleMeta, Spec} from "./Types.sol";
import {TemplateData} from "./TemplateData.sol";

/// @notice Turns one `Card` into a `data:application/json;base64,...` URI, fully onchain.
/// @dev    The metadata template (JSON envelope with the percent-encoded SVG inside) is a compile-time
///         `bytes constant` in this contract's code (`TemplateData`, generated by
///         `tools/gen_template.py`; solc reads it with `codecopy`), cut into fixed slices by the
///         constant offsets. Rendering copies slice, value, slice, value ... into one buffer and
///         Base64-encodes it once. No constructor arguments, no immutables, no storage.
contract Renderer {
    uint256 internal constant SLOTS = 34;
    uint256 internal constant SLICES = 35;

    /// @notice The template blob, for the golden tests.
    function template() external pure returns (bytes memory) {
        return TemplateData.TEMPLATE;
    }

    /// @notice The packed uint16 offsets (start, length per slice), for the golden tests.
    function offsets() external pure returns (bytes memory) {
        return _offsets();
    }

    /// @dev `TemplateData.OFFSETS` is ASCII hex (so the code data holds no forbidden opcode byte);
    ///      decode it to packed big-endian uint16 pairs.
    function _offsets() internal pure returns (bytes memory out) {
        bytes memory h = TemplateData.OFFSETS;
        out = new bytes(h.length / 2);
        for (uint256 i; i < out.length; ++i) {
            out[i] = bytes1(_nibble(h[2 * i]) * 16 + _nibble(h[2 * i + 1]));
        }
    }

    function _nibble(bytes1 c) internal pure returns (uint8) {
        uint8 b = uint8(c);
        return b >= 97 ? b - 87 : b - 48;
    }

    function tokenURI(Card memory c) external pure returns (string memory) {
        return string(abi.encodePacked("data:application/json;base64,", Base64.encode(preimage(c))));
    }

    /// @notice The metadata JSON before Base64, public so a test can diff it against the golden.
    function preimage(Card memory c) public pure returns (bytes memory out) {
        bytes[SLOTS] memory v = _values(c);
        bytes memory tpl = TemplateData.TEMPLATE;
        bytes memory offs = _offsets();
        uint256 total = tpl.length;
        for (uint256 i; i < SLOTS; ++i) {
            total += v[i].length;
        }
        out = new bytes(total);
        uint256 off;
        for (uint256 i; i < SLICES; ++i) {
            uint256 start = (uint256(uint8(offs[4 * i])) << 8) | uint256(uint8(offs[4 * i + 1]));
            uint256 len = (uint256(uint8(offs[4 * i + 2])) << 8) | uint256(uint8(offs[4 * i + 3]));
            assembly ("memory-safe") {
                mcopy(add(add(out, 0x20), off), add(add(tpl, 0x20), start), len)
            }
            off += len;
            if (i == SLOTS) break; // the last slice has no value after it
            bytes memory val = v[i];
            uint256 vl = val.length;
            assembly ("memory-safe") {
                mcopy(add(add(out, 0x20), off), add(val, 0x20), vl)
            }
            off += vl;
        }
    }

    /// @dev Slot order: name id; SVG id, claimant, 13 family values; JSON claimant, 13 family values,
    ///      community count, traits list, community list, oracle metadata.
    function _values(Card memory c) internal pure returns (bytes[SLOTS] memory v) {
        bytes memory id = bytes(Strings.toString(c.tokenId));
        bytes memory claimant = bytes(Strings.toHexString(c.claimant));
        v[0] = id;
        v[1] = id;
        v[2] = claimant;
        for (uint256 f; f < 13; ++f) {
            bytes memory val = c.top[f] == 0 ? bytes("none") : bytes(Strings.toString(c.top[f]));
            v[3 + f] = val;
            v[17 + f] = val;
        }
        v[16] = claimant;
        v[30] = bytes(Strings.toString(c.communityCount));
        v[31] = _list(c.traits);
        v[32] = _list(c.community);
        v[33] = _oracle(c.oracle);
    }

    function _list(uint16[] memory ids) internal pure returns (bytes memory out) {
        for (uint256 i; i < ids.length; ++i) {
            out = bytes.concat(out, i == 0 ? bytes("") : bytes(","), bytes(Strings.toString(ids[i])));
        }
    }

    function _oracle(OracleMeta[] memory ms) internal pure returns (bytes memory out) {
        for (uint256 i; i < ms.length; ++i) {
            out = bytes.concat(out, i == 0 ? bytes("") : bytes(","), _one(ms[i]));
        }
    }

    function _one(OracleMeta memory m) internal pure returns (bytes memory) {
        Spec memory s = m.spec;
        return bytes.concat(
            bytes.concat(
                '{"traitId":',
                bytes(Strings.toString(m.traitId)),
                ',"template":"T',
                bytes(Strings.toString(s.kind)),
                '","evidence":"',
                s.kind == 5 ? bytes("panel") : bytes("chain"),
                '","fromBlock":',
                bytes(Strings.toString(s.fromBlock)),
                ',"toBlock":',
                bytes(Strings.toString(s.toBlock)),
                ',"panelSize":',
                bytes(Strings.toString(m.panelSize)),
                ',"quorum":',
                bytes(Strings.toString(m.quorum)),
                ',"requestId":"',
                bytes(Strings.toHexString(uint256(m.requestId), 32)),
                '","oracleRequestId":"',
                bytes(Strings.toHexString(uint256(m.oracleRequestId), 32))
            ),
            bytes.concat(
                '","target":"',
                bytes(Strings.toHexString(s.target)),
                '","item":"',
                escapeJson(bytes(s.item)),
                '","arg":"',
                escapeJson(bytes(s.arg)),
                '","fixedArg":"',
                escapeJson(bytes(s.fixedArg)),
                '","fixedVal":',
                bytes(Strings.toString(s.fixedVal)),
                ',"sumArg":"',
                escapeJson(bytes(s.sumArg)),
                '","op":',
                bytes(Strings.toString(s.op)),
                ',"threshold":',
                bytes(Strings.toString(s.threshold)),
                ',"name":"',
                escapeJson(bytes(s.name)),
                '"}'
            )
        );
    }

    /// @notice JSON string escaping that also neutralises markup: `"` and `\` are escaped, and every
    ///         byte below 0x20 plus `<`, `>`, `&` becomes a `\u00XX` escape, so a hostile spec string
    ///         can break neither the JSON nor an SVG a viewer might paste it into.
    function escapeJson(bytes memory s) public pure returns (bytes memory out) {
        uint256 extra;
        for (uint256 i; i < s.length; ++i) {
            bytes1 ch = s[i];
            if (ch == '"' || ch == "\\") extra += 1;
            else if (ch < 0x20 || ch == "<" || ch == ">" || ch == "&") extra += 5;
        }
        if (extra == 0) return s;
        out = new bytes(s.length + extra);
        uint256 o;
        for (uint256 i; i < s.length; ++i) {
            bytes1 ch = s[i];
            if (ch == '"' || ch == "\\") {
                out[o++] = "\\";
                out[o++] = ch;
            } else if (ch < 0x20 || ch == "<" || ch == ">" || ch == "&") {
                out[o++] = "\\";
                out[o++] = "u";
                out[o++] = "0";
                out[o++] = "0";
                uint8 hi = uint8(ch) >> 4;
                uint8 lo = uint8(ch) & 0xf;
                out[o++] = bytes1(hi < 10 ? 48 + hi : 87 + hi);
                out[o++] = bytes1(lo < 10 ? 48 + lo : 87 + lo);
            } else {
                out[o++] = ch;
            }
        }
    }
}
