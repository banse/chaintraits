{
  "name": "sworn-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/verify-abis.mjs && vite build && node scripts/manifest.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs && node tests/browser.mjs && node tests/revision.mjs && node tests/optional-fork.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:revision": "node tests/revision.mjs",
    "verify:export": "node scripts/manifest.mjs --check",
    "art:generate": "node scripts/generate-art.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:fork": "node tests/fork.mjs",
    "derive:storage": "node scripts/derive-storage.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" vite.config.ts",
    "art:share": "node scripts/render-share.mjs",
    "check:reads": "node scripts/check-reads.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.7",
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "solc": "0.8.24",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "tmp": ">=0.2.6"
  }
}
